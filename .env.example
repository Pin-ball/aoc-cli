# Copy to .env and fill in.
#
# AOC_SESSION: log in at https://adventofcode.com and open devtools (F12).
# Find the cookies for adventofcode.com, under "Storage" in Firefox and
# "Application" in Chrome and Edge, then copy the Value of the "session" one.
# It is a long hex string that identifies your account. Treat it as a password.
AOC_SESSION=

# Sent with every request so AoC can contact you if your tooling misbehaves.
AOC_USER_AGENT=github.com/you/advent-of-code by you@example.com
